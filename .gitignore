# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Personal gallery photos — keep locally; never commit originals (see public/images/gallery/README.md)
/public/images/gallery/**
!/public/images/gallery/.gitkeep
!/public/images/gallery/README.md

# Scrapbook photos — same workflow as gallery (local only)
/public/images/scrapbook/**
!/public/images/scrapbook/.gitkeep
!/public/images/scrapbook/README.md

# Original photographs — never commit (see docs/photo-workflow.md)
/private-photo-input/**/*
!/private-photo-input/README.md
!/private-photo-input/prepare.config.json

# Prepared WebP outputs — local only (see public/photos/README.md)
/public/photos/**
!/public/photos/README.md
